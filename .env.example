APP_ENV=local
APP_DEBUG=true
# Dipakai untuk menyusun URL publik foto checkpoint (lihat src/Controllers/DriverController.php)
APP_URL=http://127.0.0.1:8000

# Sama persis MySQL produksi yang dipakai backend-production -- driver_* tabel
# app ini hidup di database yang SAMA (lihat schema.sql), cuma dikelola dari
# codebase terpisah. Isi kredensial asli manual, jangan commit .env yang sudah terisi.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=isi_nama_database_produksi
DB_USERNAME=isi_username
DB_PASSWORD=isi_password

# Ganti dengan string acak panjang (mis. `openssl rand -base64 48`) sebelum dipakai
# sungguhan -- siapa pun yang tahu nilai ini bisa memalsukan token login siapa saja.
JWT_SECRET=ganti-dengan-secret-acak-panjang
JWT_TTL_HOURS=720
